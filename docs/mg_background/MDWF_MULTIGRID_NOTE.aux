\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Mass scan on $24^3\times 48$, means over the four configurations, one random right-hand side to $|r|^2/|b|^2<10^{-18}$ on the even-odd system: even-odd CGNE in double and in mixed precision against the multigrid (GCR(2) on $\tilde  A_{L}$), $\alpha =0.6$ for both and $\alpha =1$ for the multigrid; iterations, solve time in seconds, coarse-operator applications, and $N_{\rm  rhs}$, the number of right-hand sides at which the multigrid setup ($192$--$220$\,s) is paid back, $t_{\rm  setup}/(t_{\rm  CGNE}-t_{\rm  MG})$, against the double- and the mixed-precision CGNE; speed-up: the solve time of the mixed-precision CGNE over that of the multigrid, smallest and largest over the four configurations. The mixed-precision CGNE needs the iterations of the double-precision one within $1\%$, except at $m\le 0.002$ (S), where it needs up to $30\%$ more. Final $|D\psi -\eta |^2/|\eta |^2$: $9\times 10^{-18}$--$8\times 10^{-15}$ (CGNE, both), $2\times 10^{-19}$--$4\times 10^{-18}$ (MG). Device memory peak: CGNE $6.9$\,GB (double) and $7.2$\,GB (mixed), MG $21.1$\,GB ($\alpha =0.6$).}}{35}{table.7}\protected@file@percent }
\newlabel{tab:massscan}{{7}{35}{Mass scan on $24^3\times 48$, means over the four configurations, one random right-hand side to $|r|^2/|b|^2<10^{-18}$ on the even-odd system: even-odd CGNE in double and in mixed precision against the multigrid (GCR(2) on $\AL $), $\alpha =0.6$ for both and $\alpha =1$ for the multigrid; iterations, solve time in seconds, coarse-operator applications, and $N_{\rm rhs}$, the number of right-hand sides at which the multigrid setup ($192$--$220$\,s) is paid back, $t_{\rm setup}/(t_{\rm CGNE}-t_{\rm MG})$, against the double- and the mixed-precision CGNE; speed-up: the solve time of the mixed-precision CGNE over that of the multigrid, smallest and largest over the four configurations. The mixed-precision CGNE needs the iterations of the double-precision one within $1\%$, except at $m\le 0.002$ (S), where it needs up to $30\%$ more. Final $|D\psi -\eta |^2/|\eta |^2$: $9\times 10^{-18}$--$8\times 10^{-15}$ (CGNE, both), $2\times 10^{-19}$--$4\times 10^{-18}$ (MG). Device memory peak: CGNE $6.9$\,GB (double) and $7.2$\,GB (mixed), MG $21.1$\,GB ($\alpha =0.6$)}{table.7}{}}
