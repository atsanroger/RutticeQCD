\@writefile{lot}{\contentsline {table}{\numberline {23}{\ignorespaces GCR(2) on $\tilde  A_{L}$ in setup~S, $m=0.001$, $\alpha =0.6$, to $|r|^2/|b|^2<10^{-16}$ (at most 500 iterations, 300 on $24^4$): converged runs / runs, with their iterations. ``exact'': coarse solves to $10^{-20}$ in double precision, BiCGStab on the exact Pauli--Villars adjoint; ``fixed'': the exact cycle plus $\delta \,\Gamma _5\mathcal  Mr$ or plus a fixed multiple of the smoother polynomial, $\delta $ the relative change that coarse solves to $10^{-2}$ make ($0.04$--$0.23$); ``random'': the exact cycle plus a random vector of relative size $\delta =0.02$--$0.5$, drawn anew at each application; ``solver'': the cycle of the solver (MINRES, $10^{-2}$), whose correction did not fit next to the exact one on $24^4$ (OOM). $Q$: the topological charge. Aggregates $4^4$ unless stated; configurations 2--4: three right-hand sides.}}{47}{table.23}\protected@file@percent }
\newlabel{tab:stall}{{23}{47}{GCR(2) on $\AL $ in setup~S, $m=0.001$, $\alpha =0.6$, to $|r|^2/|b|^2<10^{-16}$ (at most 500 iterations, 300 on $24^4$): converged runs / runs, with their iterations. ``exact'': coarse solves to $10^{-20}$ in double precision, BiCGStab on the exact Pauli--Villars adjoint; ``fixed'': the exact cycle plus $\delta \,\Gfive \mathcal Mr$ or plus a fixed multiple of the smoother polynomial, $\delta $ the relative change that coarse solves to $10^{-2}$ make ($0.04$--$0.23$); ``random'': the exact cycle plus a random vector of relative size $\delta =0.02$--$0.5$, drawn anew at each application; ``solver'': the cycle of the solver (MINRES, $10^{-2}$), whose correction did not fit next to the exact one on $24^4$ (OOM). $Q$: the topological charge. Aggregates $4^4$ unless stated; configurations 2--4: three right-hand sides}{table.23}{}}
