\@writefile{lot}{\contentsline {table}{\numberline {18}{\ignorespaces Real part of the field of values $W(X)$ and $\|I-X\|_2$ for $X=\tilde  A_{R}\mathcal  S$, $\tilde  A_{R}E$, $\tilde  A_{R}\mathcal  M$ (exact coarse solves). $m=0.05$ on $4^3\times 8$ ($2^4$ aggregates, 8 filtered low modes), $m=0.001$ otherwise, with the multigrid of the mass scan (16 low modes, 32 test vectors, $4^4$, Chebyshev of Table~\ref {tab:setups}) but no levels below the coarse lattice. Rows ``4 configs.'' and ``no smearing'': ranges over the four $12^4$ configurations, $M_5=1$; other rows configuration~1. On $24^4$ only $W(\tilde  A_{R})$ is given (Krylov dimensions 10 and 12 agree to six digits); there the field of values of $\tilde  A_{R}\mathcal  M$ did not settle (the two dimensions differ by $2\%$) and the eigensolvers did not fit in $24$\,GB of device memory.}}{45}{table.18}\protected@file@percent }
\newlabel{tab:fov}{{18}{45}{Real part of the field of values $W(X)$ and $\|I-X\|_2$ for $X=\AR \mathcal S$, $\AR E$, $\AR \mathcal M$ (exact coarse solves). $m=0.05$ on $4^3\times 8$ ($2^4$ aggregates, 8 filtered low modes), $m=0.001$ otherwise, with the multigrid of the mass scan (16 low modes, 32 test vectors, $4^4$, Chebyshev of Table~\ref {tab:setups}) but no levels below the coarse lattice. Rows ``4 configs.'' and ``no smearing'': ranges over the four $12^4$ configurations, $M_5=1$; other rows configuration~1. On $24^4$ only $W(\AR )$ is given (Krylov dimensions 10 and 12 agree to six digits); there the field of values of $\AR \mathcal M$ did not settle (the two dimensions differ by $2\%$) and the eigensolvers did not fit in $24$\,GB of device memory}{table.18}{}}
