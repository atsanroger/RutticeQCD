\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \New  CG iterations on $\mathcal  K^{\dagger }\mathcal  K$ (filled, solid) and on $S^{\dagger }S$ (open, dashed) against the M\"obius $c$, with $b=1+c$. Here $\mathcal  K=1-C_{e}^{-1}D_{eo}C_{o}^{-1}D_{oe}$ is the even-odd operator of Bridge++, and $S=C_{e}-D_{eo}C_{o}^{-1}D_{oe}$ is the Schur complement of Grid's default \texttt  {SchurDiagMooeeOperator} (there on the odd sites). \New  Each panel of iterations has below it a plot of the ratio of the $S^{\dagger }S$ count to the $\mathcal  K^{\dagger }\mathcal  K$ count. The upper four panels \New  (two of iterations, two of ratios) are at $\alpha =1$, the lower four at $\alpha =0.6$. In this comparison CG stops at $|r|^2/|b|^2<10^{-18}$ of its normal equations.}}{38}{figure.7}\protected@file@percent }
\newlabel{fig:cgform}{{7}{38}{\New CG iterations on $\mathcal K\dg \mathcal K$ (filled, solid) and on $S\dg S$ (open, dashed) against the M\"obius $c$, with $b=1+c$. Here $\mathcal K=1-\Ce ^{-1}D_{eo}\Co ^{-1}D_{oe}$ is the even-odd operator of Bridge++, and $S=\Ce -D_{eo}\Co ^{-1}D_{oe}$ is the Schur complement of Grid's default \texttt {SchurDiagMooeeOperator} (there on the odd sites). \New Each panel of iterations has below it a plot of the ratio of the $S\dg S$ count to the $\mathcal K\dg \mathcal K$ count. The upper four panels \New (two of iterations, two of ratios) are at $\alpha =1$, the lower four at $\alpha =0.6$. In this comparison CG stops at $|r|^2/|b|^2<10^{-18}$ of its normal equations}{figure.7}{}}
