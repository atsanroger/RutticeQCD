\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \New  GCR(2) iterations of solves with $D$ and with $D^{\dagger }$ from one setup of $D$, one cycle per step, right form, $\alpha =1$. Every solve stops when the residual of its even-site system satisfies $|r|^2/|b|^2<10^{-10}$. $16^4$ is at $m=0.01$, the other lattices at $m=0.001$; $24^4$ and $24^3\times 48$ use the levels below the coarse lattice. ``rand'' is a random right-hand side, ``res'' the residual $b-D^{\dagger }Dx_0$ of one sweep whose solve $D^{\dagger }w_0=b$ uses GCR(2) with $\Gamma _5\mathcal  M\Gamma _5$; on configuration~4 of $12^4$ in setup~S that solve stops after $2000$ iterations above $10^{-10}$. Entries are medians over the four configurations. A number in brackets counts the configurations that do not converge in $300$ iterations; ``stall'' means that none converges.}}{25}{table.3}\protected@file@percent }
\newlabel{tab:b5}{{3}{25}{\New GCR(2) iterations of solves with $D$ and with $D\dg $ from one setup of $D$, one cycle per step, right form, $\alpha =1$. Every solve stops when the residual of its even-site system satisfies $|r|^2/|b|^2<10^{-10}$. $16^4$ is at $m=0.01$, the other lattices at $m=0.001$; $24^4$ and $24^3\times 48$ use the levels below the coarse lattice. ``rand'' is a random right-hand side, ``res'' the residual $b-D\dg Dx_0$ of one sweep whose solve $D\dg w_0=b$ uses GCR(2) with $\Gfive \mathcal M\Gfive $; on configuration~4 of $12^4$ in setup~S that solve stops after $2000$ iterations above $10^{-10}$. Entries are medians over the four configurations. A number in brackets counts the configurations that do not converge in $300$ iterations; ``stall'' means that none converges}{table.3}{}}
