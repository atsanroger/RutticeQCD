\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces One factorized coarse correction, from $r$ (left) to $e$ (right), which is Eq.~\eqref  {eq:corr} read from the right, on its three lattices (the Pauli--Villars coarse solve in orange, the quark one in green): $u=\mathcal  P(\mathcal  P^{\dagger }D_{\mathrm  {PV}}^{\dagger }\mathcal  P)^{-1}\mathcal  P^{\dagger }\iota O_Rr$ is the result of the first coarse solve, that of the adjoint Pauli--Villars operator, and its even part, with $O_M$, is the right-hand side of the second, that of the quark operator, whose result is $v=\mathcal  P\mathcal  D_{\mathrm  c}^{-1}\mathcal  P^{\dagger }\iota O_M\pi u$; $e=O_L\pi B_5^{-1}v$. In blue, after ``$=$'', the values for $r=\tilde  A_{R}y$ in the right form with exact coarse solves, \New  with the vectors $s$, $\hat  t$ and $a$ that Sec.~\ref {sec:basis} derives and $B_5s,\hat  t\in \operatorname  {range}\mathcal  P$ (Eq.~\eqref  {eq:exact}; $O_R=C_{\mathrm  {PV},e}^{\dagger }$, $O_M=1$, $O_L=C_{e}$): the first solve returns the lift $\hat  t$, whose even part is $a=\pi Ds$, the second returns $B_5s$, and the correction returns $y$.}}{13}{figure.3}\protected@file@percent }
\newlabel{fig:correction}{{3}{13}{One factorized coarse correction, from $r$ (left) to $e$ (right), which is Eq.~\eqref {eq:corr} read from the right, on its three lattices (the Pauli--Villars coarse solve in orange, the quark one in green): $u=\Pro (\Pro \dg \Dpv \dg \Pro )^{-1}\Pro \dg \iota O_Rr$ is the result of the first coarse solve, that of the adjoint Pauli--Villars operator, and its even part, with $O_M$, is the right-hand side of the second, that of the quark operator, whose result is $v=\Pro \Dc ^{-1}\Pro \dg \iota O_M\pi u$; $e=O_L\pi B_5^{-1}v$. In blue, after ``$=$'', the values for $r=\AR y$ in the right form with exact coarse solves, \New with the vectors $s$, $\hat t$ and $a$ that Sec.~\ref {sec:basis} derives and $B_5s,\hat t\in \operatorname {range}\Pro $ (Eq.~\eqref {eq:exact}; $O_R=\Cpve \dg $, $O_M=1$, $O_L=\Ce $): the first solve returns the lift $\hat t$, whose even part is $a=\pi Ds$, the second returns $B_5s$, and the correction returns $y$}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Site-local factors of the correction~\eqref  {eq:corr}. They follow from $\tilde  A^{-1}$ with $S^{-1}=\pi D^{-1}\iota $; with $\alpha $ the site-diagonal blocks are $C_{e}Q_e$ and $Q_eC_{\mathrm  {PV},e}^{\dagger }$.}}{13}{table.2}\protected@file@percent }
