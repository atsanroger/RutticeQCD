\@writefile{lot}{\contentsline {table}{\numberline {20}{\ignorespaces $\min _\Gamma \sigma _{\min }(z-\tilde  A_{R}\mathcal  M)$ on circles $|z-c|=r$ (16 points each, or the number given), and the bound~\eqref  {eq:pseudobound} or~\eqref  {eq:outlierbound}: the factor per iteration $r/c$, the constant, and the iterations it guarantees for $\|r_k\|/\|r_0\|<10^{-9}$. For the dense circles $\varepsilon $ is the lower bound $\min _i\sigma _{\min }(z_i)-h/2$ on the whole circle, $h$ the spacing of the points ($\sigma _{\min }$ is $1$-Lipschitz in $z$); otherwise the smallest sampled value. Lanczos to $10^{-3}$ relative in $\sigma ^2$.}}{46}{table.20}\protected@file@percent }
